          "options": {
            "include": {
              "names": [
                "Zeit",
                "AZ Durchfluss",
                "AZ Kennfeld"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Starts und Abtauungen je ${period:text}",
      "datasource": {
        "type": "datasource",
        "uid": "-- Dashboard --"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "datasource",
            "uid": "-- Dashboard --"
          },
          "panelId": 4
        }
      ],
      "fieldConfig": {
        "defaults": {

{
  "private": true,
  "version": "0.5.9",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "TZ=America/New_York vitest run",
    "gen:api": "cd ../backend && uv run dtaluchs openapi --out ../frontend/openapi.json && cd ../frontend && openapi-typescript openapi.json -o src/lib/api-types.ts",
    "check:api": "node scripts/api-check.mjs",
    "build:lib": "vite build -c vite.lib.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.4",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "rolldown-plugin-dts": "^0.28.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "name": "@dtaluchs/core",
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./ui": {
      "types": "./dist-lib/ui.d.ts",
      "import": "./dist-lib/ui.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "files": [
    "dist-lib",
    "src/theme.css"
  ],
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "@tanstack/react-query": "^5.104.2",
    "i18next": "^26.4.4",
    "react-i18next": "^17.0.16",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  }
}
